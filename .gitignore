# Raw data stays on disk or the cluster; the small processed caches already
# tracked under Analysis/dataset/papers/ are kept.
Analysis/dataset/**/raw/

# Graphify: keep graph.json, the report, labels and the human views;
# ignore caches and the 2.4 MB graph.html that every rebuild regenerates.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/graph.html
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.pending.json
graphify-out/.graphify_root
.graphify/

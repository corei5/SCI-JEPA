.venv/
uv.lock
__pycache__/
*.py[cod]
.DS_Store

# HF / model caches
_hf_cache/
_st_cache/
_mpl_cache/

# Embedding caches written by scripts/poc/train_kg.py
scripts/poc/cache/

# Standalone HTML session reports
scripts/poc/experimental_logs_html/

# Sweep and seed-run outputs; only the summary table is committed
scripts/poc/grid/**
!scripts/poc/grid/*/
!scripts/poc/grid/*/table.md
scripts/poc/seeds/

# Graph-input JEPA runs (checkpoints, logs, plots); only each run's results.tsv is committed
scripts/poc/graph_runs/**
!scripts/poc/graph_runs/*/
!scripts/poc/graph_runs/*/results.tsv

# Site settings for GWDG Grete. Copy this file and edit it for another Slurm cluster; run_paper_a.sh
# reads it (or the file named by $SITE_ENV). Every value can also be overridden from the environment.

ACCOUNT="${ACCOUNT:-kisski-l3s-llm4sci}"
STORE="${STORE:-/mnt/vast-kisski/projects/kisski-l3s-llm4sci/gollam}"   # large project storage

# Python environment: the conda env "Alex" (activate with `conda activate Alex`). Jobs call its python
# directly, so nothing needs to be activated for sbatch. `setup` installs into it.
VENV="${VENV:-${STORE}/envs/Alex}"
PYTHON_BASE="${PYTHON_BASE:-/user/gollam.rabby/u14703/miniconda3/bin/python3}"   # only if VENV does not exist yet
LOGS="${LOGS:-${STORE}/logs}"
export HF_HOME="${HF_HOME:-${STORE}/hf_cache}"             # models are downloaded here by `setup`

DATA_ROOT="${DATA_ROOT:-${STORE}/Scientific-Summaries}"    # holds normalized/<dataset>/*.parquet
export PAPER_A_INDEX_DIR="${PAPER_A_INDEX_DIR:-${STORE}/SCI-JEPA/paper_a_data}"
export PAPER_A_OUT="${PAPER_A_OUT:-${STORE}/SCI-JEPA/paper_a_results}"
# trained models, kept apart from results: SCI-JEPA/models/<run folder name>/<experiment>/<arm>_seed<s>/
export PAPER_A_MODEL_DIR="${PAPER_A_MODEL_DIR:-${STORE}/SCI-JEPA/models/$(basename "${PAPER_A_OUT}")}"

# GPUs. grete:interactive (A100 MIG slices) starts within minutes but allows 2 jobs / 2 GPUs per user and
# 12 h per job; kisski (4 x A100 80 GB) and kisski-h100 queue for days.
DEFAULT_PARTITION="${DEFAULT_PARTITION:-grete:interactive}"
GRES_RUN="${GRES_RUN:-gpu:3g.40gb:1}"        # one GPU: run
GRES_DIST="${GRES_DIST:-gpu:3g.40gb:2}"      # several GPUs: dist
GRES_SMALL="${GRES_SMALL:-gpu:1g.10gb:1}"    # smoke / check / serve
COMPUTE_HAS_INTERNET="${COMPUTE_HAS_INTERNET:-0}"   # Grete compute nodes: no internet (models come from setup)

# LLM-Reasoning comparison systems: one BENCH arm per model (freely downloadable, no licence gate; up to ~8 B,
# one per family: Qwen 3 (Alibaba), OLMo 3 (AI2, open training data), Granite 3.3 (IBM), Phi-4-mini (Microsoft)).
# Downloaded by `setup`; override per run with LLM_MODELS=... (comma-separated) after the script name.
export LLM_MODELS="${LLM_MODELS:-Qwen/Qwen3-8B,allenai/Olmo-3-7B-Instruct,ibm-granite/granite-3.3-8b-instruct,microsoft/Phi-4-mini-instruct}"
# speed on the A100 / H100 nodes (scaling/README.md): bf16, fused attention, TF32, fused AdamW, and the training
# batches built in worker processes (dist: BATCH_WORKERS defaults to each shard's CPUs minus one, at most 8)
export SPEED="${SPEED:-gpu}"
